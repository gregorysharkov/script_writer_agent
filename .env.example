# Pragmatic Content Factory - Environment Variables
# =================================================
# Copy this file to .env and fill in the values

# Google Gemini API (required for YouTube processing, translation, and entity extraction)
GOOGLE_API_KEY=your-google-api-key-here

# Neo4j Database (optional - defaults shown)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Content Fetching (optional)
DOWNLOAD_DIR=data/downloaded
MAX_CONCURRENT_FETCHES=3

# Gemini Model (optional - defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
